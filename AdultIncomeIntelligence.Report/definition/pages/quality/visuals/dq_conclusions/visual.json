                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#F3EEE4",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "the rate peaks at ages 45 to 54 (40.1%).",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#CFC9DC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Sex: ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#F3EEE4",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "30.6% of men and 10.9% of women, and the gap shows up at every education level.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#CFC9DC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Next: ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#F3EEE4",
                      "fontWeight": "bold"
                    }
