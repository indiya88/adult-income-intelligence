	partition adult_income = m
		mode: import
		source =
				let
					// Load the CSV and use the first row as column names
					Source = Csv.Document(File.Contents(CsvPath), [Delimiter=",", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.None]),
					#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					// Set the right type for every column
					Typed = Table.TransformColumnTypes(#"Promoted Headers", {
						{"age", Int64.Type}, {"fnlwgt", Int64.Type}, {"education.num", Int64.Type},
						{"capital.gain", Int64.Type}, {"capital.loss", Int64.Type}, {"hours.per.week", Int64.Type},
						{"workclass", type text}, {"education", type text}, {"marital.status", type text},
						{"occupation", type text}, {"relationship", type text}, {"race", type text},
						{"sex", type text}, {"native.country", type text}, {"income", type text}}),
					// Remove stray spaces from text columns
					TextCols = {"workclass","education","marital.status","occupation","relationship","race","sex","native.country","income"},
					Trimmed = Table.TransformColumns(Typed, List.Transform(TextCols, each {_, Text.Trim, type text})),
					// Label blanks and question marks as "unknown" instead of dropping the rows
					Unknowns = Table.TransformColumns(Trimmed, List.Transform(TextCols, each {_, (v) => if v = null or v = "" or v = "?" or v = "nan" then "unknown" else v, type text})),
					// 1 if the person earns above $50K, 0 if not (easy to add up)
					HighIncome = Table.AddColumn(Unknowns, "high_income", each if Text.Contains([income], ">50K") then 1 else 0, Int64.Type),
					// Age groups, with a number column so they sort in the right order
					AgeGroup = Table.AddColumn(HighIncome, "age_group", each
						if [age] <= 24 then "17–24" else if [age] <= 34 then "25–34" else if [age] <= 44 then "35–44"
						else if [age] <= 54 then "45–54" else if [age] <= 64 then "55–64" else "65+", type text),
					AgeOrder = Table.AddColumn(AgeGroup, "age_group_order", each
						if [age] <= 24 then 1 else if [age] <= 34 then 2 else if [age] <= 44 then 3
						else if [age] <= 54 then 4 else if [age] <= 64 then 5 else 6, Int64.Type),
					// Weekly hours grouped into bands, also with a sort column
					HoursBand = Table.AddColumn(AgeOrder, "hours_band", each
						if [hours.per.week] <= 19 then "0–19" else if [hours.per.week] <= 34 then "20–34"
						else if [hours.per.week] <= 40 then "35–40" else if [hours.per.week] <= 49 then "41–49"
						else if [hours.per.week] <= 59 then "50–59" else "60+", type text),
					HoursOrder = Table.AddColumn(HoursBand, "hours_band_order", each
						if [hours.per.week] <= 19 then 1 else if [hours.per.week] <= 34 then 2
						else if [hours.per.week] <= 40 then 3 else if [hours.per.week] <= 49 then 4
						else if [hours.per.week] <= 59 then 5 else 6, Int64.Type),
					// Education grouped into 7 readable levels (the 16 originals are kept too)
					EduGroup = Table.AddColumn(HoursOrder, "education_level", each
						if [education.num] <= 8 then "Less than high school" else if [education.num] = 9 then "High school"
						else if [education.num] = 10 then "Some college" else if [education.num] <= 12 then "Associate"
						else if [education.num] = 13 then "Bachelor's" else if [education.num] = 14 then "Master's"
						else "Doctorate or professional", type text),
					EduOrder = Table.AddColumn(EduGroup, "education_level_order", each
						if [education.num] <= 8 then 1 else if [education.num] = 9 then 2 else if [education.num] = 10 then 3
						else if [education.num] <= 12 then 4 else if [education.num] = 13 then 5 else if [education.num] = 14 then 6
						else 7, Int64.Type)
				in
					EduOrder

	annotation PBI_ResultType = Table

