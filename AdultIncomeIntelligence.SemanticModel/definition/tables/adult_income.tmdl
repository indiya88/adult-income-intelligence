table adult_income
	lineageTag: 4b9c9fdb-b4a1-5074-9769-7c6c13dc5c77

	/// Number of people in the current selection.
	measure People = COUNTROWS ( adult_income )
		formatString: #,0
		displayFolder: Core
		lineageTag: 131be629-72be-5a1c-bab6-6799e3de00c3

	/// People earning above $50K.
	measure 'Above $50K' = SUM ( adult_income[high_income] )
		formatString: #,0
		displayFolder: Core
		lineageTag: d5afaf12-df23-53a3-8d99-202876afadc1

	/// People earning $50K or less.
	measure 'Below $50K' = [People] - [Above $50K]
		formatString: #,0
		displayFolder: Core
		lineageTag: 1ced0a86-9a06-522a-bf2b-34af52aac735

	/// Share of the selection earning above $50K. Used for every group comparison so big and small groups compare fairly.
	measure 'Above $50K Rate' = DIVIDE ( [Above $50K], [People] )
		formatString: 0.0%
		displayFolder: Core
		lineageTag: 1d2b6b1a-dd6c-555d-99f0-ceb3b2898e5e

	/// Middle value of hours worked per week.
	measure 'Median Weekly Hours' = MEDIAN ( adult_income[hours.per.week] )
		formatString: 0
		displayFolder: Core
		lineageTag: 2310425b-53cf-57a1-af4c-5e16173974fa

	/// Youngest to oldest age in the selection.
	measure 'Age Range' =
			VAR youngest = MIN ( adult_income[age] )
			VAR oldest = MAX ( adult_income[age] )
			RETURN IF ( ISBLANK ( youngest ), BLANK (), youngest & "–" & oldest )
		displayFolder: Core
		lineageTag: 13a474aa-f16e-5784-9b56-ce96443a3b0c

	/// All rows in the dataset, ignoring filters.
	measure 'Total Rows' = CALCULATE ( COUNTROWS ( adult_income ), REMOVEFILTERS ( adult_income ) )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: e714767a-6bc9-572b-9d2e-31c296ee5434

	/// Columns in the original CSV.
	measure 'Original Columns' = 15
		formatString: 0
		displayFolder: Data Quality
		lineageTag: b3610240-e825-5f5b-8af0-5e891740b38c

	/// Rows that exactly match another row. Kept, since identical records can be different people.
	measure 'Duplicate Rows' = [Total Rows] - COUNTROWS ( DISTINCT ( ALL ( adult_income ) ) )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: d20b4a66-0fd3-572f-888b-2325f68f8f23

	/// Missing workclass values, labeled unknown.
	measure 'Unknown Workclass' = CALCULATE ( COUNTROWS ( adult_income ), REMOVEFILTERS ( adult_income ), adult_income[workclass] = "unknown" )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: f46f2512-42f4-542d-9bb7-e026bb7141e2

	/// Missing occupation values, labeled unknown.
	measure 'Unknown Occupation' = CALCULATE ( COUNTROWS ( adult_income ), REMOVEFILTERS ( adult_income ), adult_income[occupation] = "unknown" )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: fef1b2e0-588e-54c9-a978-42e844dd69a4

	/// Blank native country values, labeled unknown.
	measure 'Unknown Country' = CALCULATE ( COUNTROWS ( adult_income ), REMOVEFILTERS ( adult_income ), adult_income[native.country] = "unknown" )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 6d52cc7a-eb0b-5d65-a8a1-24eddc018308

	/// Headline: how many people earn above $50K.
	measure 'Insight Income Split' =
			IF (
				[People] = 0,
				"No records match these filters.",
				FORMAT ( [Above $50K], "#,0" ) & " of " & FORMAT ( [People], "#,0" ) & " people ("
					& FORMAT ( [Above $50K Rate], "0.0%" ) & ") earn above $50K."
			)
		displayFolder: Insights
		lineageTag: 82020e53-81c3-5d2a-90e3-52390b46b02b

	/// Education level with the highest above-$50K rate.
	measure 'Insight Education' =
			// Find the group with the highest above-$50K rate, skipping tiny groups
			VAR minGroup = MAX ( 20, INT ( [People] * 0.005 ) )
			VAR groups =
				FILTER (
					ADDCOLUMNS (
						VALUES ( adult_income[education] ),
						"@people", [People],
						"@high", [Above $50K],
						"@rate", [Above $50K Rate]
					),
					[@people] >= minGroup
				)
			VAR best = TOPN ( 1, groups, [@rate], DESC )
			VAR bestName = MAXX ( best, adult_income[education] )
			RETURN
				IF (
					ISBLANK ( bestName ),
					"Not enough records in this selection.",
					bestName & " has the highest share earning above $50K: "
						& FORMAT ( MAXX ( best, [@rate] ), "0.0%" ) & " ("
						& FORMAT ( MAXX ( best, [@high] ), "#,0" ) & " of "
						& FORMAT ( MAXX ( best, [@people] ), "#,0" ) & ")."
				)
		displayFolder: Insights
		lineageTag: ead610f5-7e2e-5779-9b96-a3de5c46296d

	/// Occupation with the highest above-$50K rate.
	measure 'Insight Occupation' =
			// Find the group with the highest above-$50K rate, skipping tiny groups
			VAR minGroup = MAX ( 20, INT ( [People] * 0.005 ) )
			VAR groups =
				FILTER (
					ADDCOLUMNS (
						VALUES ( adult_income[occupation] ),
						"@people", [People],
						"@high", [Above $50K],
						"@rate", [Above $50K Rate]
					),
					[@people] >= minGroup
				)
			VAR best = TOPN ( 1, groups, [@rate], DESC )
			VAR bestName = MAXX ( best, adult_income[occupation] )
			RETURN
				IF (
					ISBLANK ( bestName ),
					"Not enough records in this selection.",
					bestName & " has the highest share earning above $50K: "
						& FORMAT ( MAXX ( best, [@rate] ), "0.0%" ) & " ("
						& FORMAT ( MAXX ( best, [@high] ), "#,0" ) & " of "
						& FORMAT ( MAXX ( best, [@people] ), "#,0" ) & ")."
				)
		displayFolder: Insights
		lineageTag: ec1188ae-f631-55ba-bab0-fd2c4de0493c

	/// Age group with the highest above-$50K rate.
	measure 'Insight Age' =
			// Find the group with the highest above-$50K rate, skipping tiny groups
			VAR minGroup = MAX ( 20, INT ( [People] * 0.005 ) )
			VAR groups =
				FILTER (
					ADDCOLUMNS (
						VALUES ( adult_income[age_group] ),
						"@people", [People],
						"@high", [Above $50K],
						"@rate", [Above $50K Rate]
					),
					[@people] >= minGroup
				)
			VAR best = TOPN ( 1, groups, [@rate], DESC )
			VAR bestName = MAXX ( best, adult_income[age_group] )
			RETURN
				IF (
					ISBLANK ( bestName ),
					"Not enough records in this selection.",
					"People aged " & bestName & " have the highest share earning above $50K: "
						& FORMAT ( MAXX ( best, [@rate] ), "0.0%" ) & " ("
						& FORMAT ( MAXX ( best, [@high] ), "#,0" ) & " of "
						& FORMAT ( MAXX ( best, [@people] ), "#,0" ) & ")."
				)
		displayFolder: Insights
		lineageTag: 348fbe75-849a-571e-a590-3f0d0f6a0205

	/// Weekly hours band with the highest above-$50K rate.
	measure 'Insight Hours' =
			// Find the group with the highest above-$50K rate, skipping tiny groups
			VAR minGroup = MAX ( 20, INT ( [People] * 0.005 ) )
			VAR groups =
				FILTER (
					ADDCOLUMNS (
						VALUES ( adult_income[hours_band] ),
						"@people", [People],
						"@high", [Above $50K],
						"@rate", [Above $50K Rate]
					),
					[@people] >= minGroup
				)
			VAR best = TOPN ( 1, groups, [@rate], DESC )
			VAR bestName = MAXX ( best, adult_income[hours_band] )
			RETURN
				IF (
					ISBLANK ( bestName ),
					"Not enough records in this selection.",
					"People working " & bestName & " hours a week have the highest share earning above $50K: "
						& FORMAT ( MAXX ( best, [@rate] ), "0.0%" ) & " ("
						& FORMAT ( MAXX ( best, [@high] ), "#,0" ) & " of "
						& FORMAT ( MAXX ( best, [@people] ), "#,0" ) & ")."
				)
		displayFolder: Insights
		lineageTag: 29443a2b-aaba-5edf-91f8-ecbf0f415ba5

	/// Above-$50K rate for men compared with women, within the other filters.
	measure 'Insight Sex Gap' =
			VAR men = CALCULATE ( [Above $50K Rate], adult_income[sex] = "Male" )
			VAR women = CALCULATE ( [Above $50K Rate], adult_income[sex] = "Female" )
			RETURN
				IF (
					ISBLANK ( men ) || ISBLANK ( women ),
					"Not enough records to compare men and women.",
					"Men earn above $50K at " & FORMAT ( men, "0.0%" ) & " compared with "
						& FORMAT ( women, "0.0%" ) & " for women, a gap of "
						& FORMAT ( ( men - women ) * 100, "0.0" ) & " percentage points."
				)
		displayFolder: Insights
		lineageTag: 3142c916-920a-5082-bd44-304c969475dc

	/// Bachelor's degree or higher compared with high school or less.
	measure 'Insight Degree Gap' =
			VAR degree = CALCULATE ( [Above $50K Rate], adult_income[education.num] >= 13 )
			VAR highSchool = CALCULATE ( [Above $50K Rate], adult_income[education.num] <= 9 )
			RETURN
				IF (
					ISBLANK ( degree ) || ISBLANK ( highSchool ),
					"Not enough records to compare education levels.",
					"A bachelor's degree or higher: " & FORMAT ( degree, "0.0%" )
						& " earn above $50K, compared with " & FORMAT ( highSchool, "0.0%" )
						& " for high school or less."
				)
		displayFolder: Insights
		lineageTag: 2d4bf380-da8e-5e7a-8edf-e283e9ee3976

